{% set bodyClass = 'ltr bg-[#0f0f0f] text-[#e8e0d0] font-sans' %}
{% include "_partials/_head.twig" %}

{% block content %}
    {% include "_partials/_nav.twig" %}

    <section class="relative flex h-[34rem] items-center justify-center px-6 text-center md:h-[44rem]"
             style="background-image: linear-gradient(rgba(15, 15, 15, 0.42), rgba(15, 15, 15, 0.9)), url('/assets/contact-banner.jpg');
                    background-size: cover;
                    background-repeat: no-repeat;
                    background-position: center center;">
        <div class="max-w-4xl">
            <p class="mb-5 text-xs font-bold uppercase tracking-[0.35em] text-[#c9a84c] md:text-sm">
                Visit or call us
            </p>
            <h1 class="text-5xl font-bold leading-none text-[#f5f0e8] md:text-7xl lg:text-8xl">
                Contact Us
            </h1>
            <div class="mx-auto mt-8 h-px w-20 bg-[#c9a84c]"></div>
        </div>
    </section>

    <main class="border-t border-[#c9a84c]/25 bg-[#0f0f0f] px-4 py-20 md:px-10 md:py-28 xl:px-40">
        <div class="mx-auto max-w-7xl">
            <div class="prose prose-lg max-w-3xl text-[#9a8f80] prose-headings:text-[#f5f0e8] prose-p:text-[#9a8f80] prose-a:text-[#c9a84c]">
                {{ entry.richText }}
            </div>

            <div class="mt-12 grid items-start gap-12 md:grid-cols-3 lg:gap-20">
                <div class="space-y-8 md:col-span-1">
                    <a href="#"
                       class="group flex items-start gap-4 border-t border-[#c9a84c]/25 pt-5 text-[#e8e0d0] transition-colors duration-200 hover:text-[#c9a84c]">
                        <svg xmlns="http://www.w3.org/2000/svg"
                             fill="none"
                             viewBox="0 0 24 24"
                             stroke-width="1.5"
                             stroke="currentColor"
                             class="h-6 w-6 shrink-0 text-[#c9a84c]">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503 3.498 4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 0 0-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0Z" />
                        </svg>
                        <span class="leading-relaxed">1601 West St., Utica, NY</span>
                    </a>

                    <a href="tel:3153030281"
                       class="group flex items-start gap-4 border-t border-[#c9a84c]/25 pt-5 text-[#e8e0d0] transition-colors duration-200 hover:text-[#c9a84c]">
                        <svg xmlns="http://www.w3.org/2000/svg"
                             fill="none"
                             viewBox="0 0 24 24"
                             stroke-width="1.5"
                             stroke="currentColor"
                             class="h-6 w-6 shrink-0 text-[#c9a84c]">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 3.75v4.5m0-4.5h-4.5m4.5 0-6 6m3 12c-8.284 0-15-6.716-15-15V4.5A2.25 2.25 0 0 1 4.5 2.25h1.372c.516 0 .966.351 1.091.852l1.106 4.423c.11.44-.054.902-.417 1.173l-1.293.97a1.062 1.062 0 0 0-.38 1.21 12.035 12.035 0 0 0 7.143 7.143c.441.162.928-.004 1.21-.38l.97-1.293a1.125 1.125 0 0 1 1.173-.417l4.423 1.106c.5.125.852.575.852 1.091V19.5a2.25 2.25 0 0 1-2.25 2.25h-2.25Z" />
                        </svg>
                        <span class="leading-relaxed">(315) 303-0281</span>
                    </a>
                </div>

                <div class="border border-[#c9a84c]/25 p-2 md:col-span-2">
                    <div class="relative h-0 w-full pb-[65%]">
                        <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d23276.849325897474!2d-76.32427465106558!3d43.17579041621055!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x89d9e45d09389095%3A0xd66a1d43d9a12aa5!2s80%20Smokey%20Hollow%20Rd%2C%20Baldwinsville%2C%20NY%2013027!5e0!3m2!1sen!2sus!4v1730761994748!5m2!1sen!2sus"
                                class="absolute left-0 top-0 h-full w-full border-0 grayscale-[35%]"
                                allowfullscreen=""
                                loading="lazy"
                                referrerpolicy="no-referrer-when-downgrade">
                        </iframe>
                    </div>
                </div>
            </div>
        </div>
    </main>
{% endblock %}

{% include "_partials/_footer.twig" %}
</body>
</html>
